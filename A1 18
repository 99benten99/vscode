#include <iostream>
using namespace std;

int main() {
    int n;
    cin >> n;

    if (n < 0) {
        cout << "Error : Please input positive number" << endl;
    } else if (n == 0 || n > 9) {
        cout << "Error : Out of range" << endl;
    } else {
        string roman[] = {"", "I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX"};
        cout << roman[n] << endl;
    }

    return 0;
}
