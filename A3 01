#include <iostream>
#include <vector>
#include <cmath>
using namespace std;

struct Node {
    bool isLeftWeight, isRightWeight;
    int leftValue, rightValue;
};

vector<Node> nodes;
vector<double> totalWeight;
vector<double> addWeight;

double dfs(int i) {
    double leftW, rightW;

    // Left side
    if (nodes[i].isLeftWeight)
        leftW = nodes[i].leftValue;
    else
        leftW = dfs(nodes[i].leftValue - 1);

    // Right side
    if (nodes[i].isRightWeight)
        rightW = nodes[i].rightValue;
    else
        rightW = dfs(nodes[i].rightValue - 1);

    // Calculate weight to add for balance
    if (fabs(leftW - rightW) < 1e-9) {
        addWeight[i] = 0;
    } else if (leftW < rightW) {
        addWeight[i] = rightW - leftW;
        leftW = rightW;
    } else {
        addWeight[i] = leftW - rightW;
        rightW = leftW;
    }

    totalWeight[i] = leftW + rightW;
    return totalWeight[i];
}

int main() {
    int N;
    cin >> N;
    nodes.resize(N);
    totalWeight.resize(N);
    addWeight.resize(N);

    for (int i = 0; i < N; ++i) {
        int A, L, B, R;
        cin >> A >> L >> B >> R;
        nodes[i] = {A == 1, B == 1, L, R};
    }

    dfs(0);

    double result = 0;
    for (int i = 0; i < N; ++i) {
        if (nodes[i].isLeftWeight)
            result += addWeight[i] / 2;
        if (nodes[i].isRightWeight)
            result += addWeight[i] / 2;
    }

    cout << fixed;
    cout.precision(0);
    cout << round(result) << endl;

    return 0;
}
